# ===== SmartReview 后端配置示例 =====
# 复制为 backend/.env 后按环境填写。前缀 SMARTREVIEW_。

# ---- 服务 ----
SMARTREVIEW_API_HOST=0.0.0.0
SMARTREVIEW_API_PORT=8002

# ---- LLM 提供商（按逗号顺序尝试，先健康者优先；均 OpenAI 兼容）----
# 1) 本地 vLLM（微调权重就绪后指向该服务）
SMARTREVIEW_VLLM_BASE_URL=http://127.0.0.1:8001/v1
SMARTREVIEW_VLLM_API_KEY=
SMARTREVIEW_VLLM_MODEL=Qwen2.5-14B-Instruct
# 2) 硅基流动（云端降级；未配置 key 则跳过）
SMARTREVIEW_SF_BASE_URL=https://api.siliconflow.cn/v1
SMARTREVIEW_SF_API_KEY=
SMARTREVIEW_SF_MODEL=Qwen/Qwen2.5-14B-Instruct
# 当前轮次默认提供商顺序（vllm 不可用时自动落到 siliconflow）
SMARTREVIEW_LLM_PROVIDERS=vllm,siliconflow
SMARTREVIEW_LLM_TEMPERATURE=0.1
SMARTREVIEW_LLM_MAX_TOKENS=1200

# ---- 嵌入（硅基流动 API；法律知识库建索引用）----
# 留空则无法建索引/检索；可复用下方 LLM 的 SF key，也可单独申请
SMARTREVIEW_SF_EMBEDDING_API_KEY=
SMARTREVIEW_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SMARTREVIEW_EMBEDDING_MODEL=BAAI/bge-m3

# ---- 重排序 Reranker（二段检索：向量召回 Top-K 后再精排，提升法条命中率）----
# 审查每个条款都走 RAG；rerank 需要 SF Key（sf_api_key 或 embedding key 任一即可）
SMARTREVIEW_RERANK_ENABLED=true
SMARTREVIEW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 独立重排序端点；留空自动回落 SF_BASE_URL（api.siliconflow.cn/v1）
SMARTREVIEW_RERANK_BASE_URL=
SMARTREVIEW_RERANK_TIMEOUT_SECONDS=30
# 重排后保留进入 LLM Prompt 的法条块数
SMARTREVIEW_RERANK_TOP_K=3

# ---- 分块 / 检索 ----
SMARTREVIEW_CHUNK_SIZE=512
SMARTREVIEW_CHUNK_OVERLAP=64
SMARTREVIEW_TOP_K=5
SMARTREVIEW_SIMILARITY_THRESHOLD=0.4
SMARTREVIEW_COLLECTION_NAME=smartreview_law

# ---- 审查调度 ----
SMARTREVIEW_WORKERS=8
SMARTREVIEW_MAX_CLAUSE_CHARS=2000
SMARTREVIEW_UPLOAD_MAX_MB=20
